    <suppress>
        <notes>
            Nu Html Checker (validator.nu) contains a restriction bypass that allows remote attackers to make the server perform arbitrary HTTP/HTTPS requests to internal resources, including localhost services.
        </notes>
        <cve>CVE-2025-15104</cve>
    </suppress>
    <suppress until="2026-10-31Z">
        <notes>
            CVE-2026-66299 affects Apache Tomcat's WebSocket chat example. This Spring Boot application uses embedded Tomcat and does not deploy
            Tomcat's examples web application. Apache lists the fix in Tomcat 10.1.58, but that release is not yet available in Maven Central.
            Keep the existing Tomcat 10.1.57 override until 10.1.58 can be consumed.
        </notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-(core|websocket)@.*$</packageUrl>
        <cve>CVE-2026-66299</cve>
    </suppress>
